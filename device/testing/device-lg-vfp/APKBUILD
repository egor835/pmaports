# Reference: <https://postmarketos.org/devicepkg>
maintainer="Egor 835 <egor.su.8@gmail.com>"
pkgname=device-lg-vfp
pkgdesc="LG Wine Smart"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-msm8226
	mkbootimg
	postmarketos-base
	soc-qcom-msm8226
	"
makedepends="devicepkg-dev"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"
source="
	deviceinfo
	modules-initfs
	WCNSS_qcom_wlan_nv.bin
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

nonfree_firmware() {
	pkgdesc="WiFi/BT and GPU firmware (wcnss from the modem partition, NV from stock)"
	depends="msm-firmware-loader firmware-qcom-adreno-a330"
	install -Dm644 "$srcdir"/WCNSS_qcom_wlan_nv.bin \
		"$subpkgdir"/lib/firmware/wlan/prima/WCNSS_qcom_wlan_nv.bin
}
