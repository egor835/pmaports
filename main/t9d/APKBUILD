# Maintainer: Egor 835 <egor.su.8@gmail.com>
pkgname=t9d
pkgver=0.1
pkgrel=0
pkgdesc="Multi-tap (feature phone style) text entry for hardware phone keypads"
url="https://github.com/egor835/pmaports"
arch="noarch"
license="MIT"
depends="python3 py3-evdev"
options="!check" # no tests
source="
	t9d.py
	t9d.service
	80-t9d.preset
	"

package() {
	install -Dm755 "$srcdir"/t9d.py "$pkgdir"/usr/bin/t9d
	install -Dm644 "$srcdir"/t9d.service \
		"$pkgdir"/usr/lib/systemd/system/t9d.service
	install -Dm644 "$srcdir"/80-t9d.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/80-t9d.preset
}
